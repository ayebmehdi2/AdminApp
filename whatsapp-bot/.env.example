# Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  - low is fast and cheap, and enough for most customer chat
CLAUDE_EFFORT=low

# WhatsApp Cloud API (Meta developer dashboard -> WhatsApp -> API setup)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any random string; paste the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=change-me
# Meta app -> Settings -> Basic -> App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=...
GRAPH_API_VERSION=v22.0

# Business owner's WhatsApp number (international format, digits only).
# Gets notified about orders/bookings/handoffs and can send #reply / #resume commands.
OWNER_WHATSAPP_NUMBER=21612345678

# Protects the /admin endpoints
ADMIN_TOKEN=change-me-too

BUSINESS_FILE=business.json
DB_PATH=bot.db
